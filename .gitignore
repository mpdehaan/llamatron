songs/
__pycache__/
*.py[cod]
*$py.class
.venv/
# What the tools make for a person to look at and keep: output/previews/, output/recordings/, and output/corpus/, the
# public domain corpus user_scripts/fetch_corpus.sh downloads, never committed.
output/
examples/**/*.als
examples/**/*.mid
*.mid
.DS_Store
build/
dist/
*.egg-info/
# The public domain MIDI files to import, which the demo generator and the tests read too, kept so nothing is downloaded again.
!examples/midi/*.mid
# Every cache a tool keeps, rebuilt by the tool: compare_exports/, constants_by_module.json, docs_site/.
.cache/
# What the test runs keep: how long each test class took, which tests/support/parallel.py starts the slowest first by, and
# which classes run which source files, made by internal_tools/test_map.sh, with the coverage data it is made from.
tests/.cache/
examples/**/*.wav
# The agreed designs not yet built, kept on this computer only.
.claude/planning/DESIGNS.md
.claude/planning/WIZARD_DESIGNS.md
.compare_screens/
.compare_screens_again/
.sample_profiles/
# What cargo builds from the synth daemon's source, rebuilt by internal_tools/build_backend.sh.
src/target/

