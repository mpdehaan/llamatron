# The public domain MIDI files to import, which the demo generator and the tests read too, kept so nothing is downloaded again.
!examples/midi/*.mid
.compare_exports/
previews/
recordings/
# What the test runs keep: how long each test class took, which tests/support/parallel.py starts the slowest first by, and
# which classes run which source files, made by internal_tools/test_map.sh, with the coverage data it is made from.
tests/.cache/
# What each module defines and imports, kept by internal_tools/constants_by_module.py so that the commit check reads only changed files.
.constants_by_module.json
# Where internal_tools/build_docs.sh installs VitePress and stages the pages; the site itself is web_docs/.
.docs_site/
examples/**/*.wav
# The public-domain scores internal_tools/analysis_and_generation/fetch_corpus.sh fetches for the corpus study, kept out of the repository.
.corpus/
# Claude's own list of what is built next, kept on this computer only (the user's choice).
.claude/QUEUE.md
# Claude's plan and status for the refactoring, kept on this computer only: no status of work or list of planned work is in the repository.
.claude/features/REFACTORING.md
.claude/DESIGNS.md
.claude/features/WIZARD_DESIGNS.md
.claude/features/REFACTORING_LOG.md
